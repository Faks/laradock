# Caddy Snippets for DEVELOPMENT PHP-FPM Versions
# ----------------------------------------------------------------------
# Defines reusable snippets for connecting to different PHP-FPM services

# PHP 5.6
(php_56_development) {
    php_fastcgi php-fpm-56-development:9000
}

# PHP 7.4
(php_74_development) {
    php_fastcgi php-fpm-74-development:9000
}

