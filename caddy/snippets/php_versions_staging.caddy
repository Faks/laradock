# Caddy Snippets for staging PHP-FPM Versions
# ----------------------------------------------------------------------
# Defines reusable snippets for connecting to different PHP-FPM services

# PHP 5.6
(php_56_staging) {
    php_fastcgi php-fpm-56-staging:9000
}

# PHP 7.4
(php_74_staging) {
    php_fastcgi php-fpm-74-staging:9000
}

