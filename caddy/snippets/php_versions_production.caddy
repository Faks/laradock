# Caddy Snippets for production PHP-FPM Versions
# ----------------------------------------------------------------------
# Defines reusable snippets for connecting to different PHP-FPM services

# PHP 5.6
(php_56_production) {
    php_fastcgi php-fpm-56-production:9000
}

# PHP 7.4
(php_74_production) {
    php_fastcgi php-fpm-74-production:9000
}

