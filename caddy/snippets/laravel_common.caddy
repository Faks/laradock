# Common Caddy settings for Laravel Applications with enhanced security and performance
(laravel_common) {
    # Enable compression using zstd and gzip for faster content delivery
    encode zstd gzip

    # Serve static files directly from the public root directory
    file_server

    # Standard Laravel front-controller pattern
    # Try to serve the requested file or directory, otherwise route to index.php with query string
    try_files {path} {path}/ /index.php?{query}

    # Restrict access to sensitive files and directories to prevent exposure
    @forbidden {
        path /.env                # Block access to environment configuration file
        path /storage/*           # Block access to storage directory contents
        path /vendor/*            # Block access to vendor directory contents
        path /.git/*              # Block access to Git repository files
        path /.htaccess           # Block access to Apache config files
        path /composer.json       # Block access to composer.json file
        path /composer.lock       # Block access to composer.lock file
    }
    # Respond with HTTP 403 Forbidden for any requests matching @forbidden
    respond @forbidden 403

    # Block access to hidden files or directories (starting with a dot) anywhere in the path
    @hidden path_regexp hidden ^\.
    route @hidden {
        abort                   # Abort the request with a 404 Not Found
    }

    # Cache static assets aggressively for better performance
    @static {
        path_regexp static \.(css|js|png|jpg|jpeg|gif|svg|woff|woff2|ttf|eot)$
    }
    # Add Cache-Control header to static assets for long-term caching and immutability
    header @static Cache-Control "public, max-age=31536000, immutable"

    # Limit the maximum size of the request body to 128 megabytes (matches PHP limits)
    request_body {
        max_size 128MB
    }

    # Add common security headers to all responses
    header {
        # Enable HTTP Strict Transport Security (HSTS)
        # Instruct browsers to always use HTTPS for one year, including subdomains, and preload list
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

        # Prevent Clickjacking by allowing framing only from the same origin
        X-Frame-Options "SAMEORIGIN"

        # Prevent MIME type sniffing to reduce exposure to drive-by download attacks
        X-Content-Type-Options "nosniff"

        # Enable legacy XSS protection in browsers (mostly superseded by CSP)
        X-XSS-Protection "1; mode=block"

        # Control referrer information sent with requests for privacy
        Referrer-Policy "strict-origin-when-cross-origin"

        # Define a basic Content Security Policy to restrict sources of content and scripts
        Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:;"

        # Remove the default "Server: Caddy" header for minor security through obscurity
        -Server
    }
}